#!/usr/bin/env python3
"""Launcher: runs paiper from this checkout, no install needed."""
import os
import sys

if sys.version_info < (3, 9):
    sys.exit("paiper needs Python 3.9 or newer; this is " + sys.version.split()[0])
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from paiper.cli import main  # noqa: E402

main()
